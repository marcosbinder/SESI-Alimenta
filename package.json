{
  "name": "sesi-alimenta",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/gateway.js --spawn",
    "start:gateway": "node src/gateway.js",
    "start:main": "node src/server.js",
    "dev:server": "node src/gateway.js --spawn",
    "dev:site": "cd site && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:site\"",
    "test": "node tests/test_security.mjs && node tests/test_backend_api.mjs && node tests/test_frontend_integrity.mjs && node tests/test_challenger_m1_1.mjs && node tests/test_challenger_m1_1_stress.mjs && npm run build --prefix site"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "concurrently": "^8.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.5.0",
    "node-windows": "1.0.0-beta.8",
    "otplib": "^12.0.1",
    "proxy-addr": "^2.0.8",
    "qrcode": "^1.5.3",
    "sanitize-html": "^2.17.6",
    "speakeasy": "^2.0.0",
    "ws": "^8.21.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10"
  }
