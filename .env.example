# ==============================================================================
# SESI Alimenta - Arquivo de Configuração de Ambiente (.env)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto e configure os valores para o seu ambiente.
# 
# ATENÇÃO DE SEGURANÇA:
# - NUNCA comite o arquivo .env no Git.
# - Mantenha o arquivo com permissões restritas no servidor de produção (chmod 600 ou ACL Windows).
# - O JWT_SECRET DEVE possuir no mínimo 32 caracteres criptograficamente aleatórios.
# ==============================================================================

# Porta de entrada da rede para o Gateway Sentinela (padrão: 3000)
PORT=3000
GATEWAY_PORT=3000

# Porta interna de escuta do backend Express supervisionado pelo Gateway (padrão: 3001)
BACKEND_PORT=3001

# Chave secreta mestra para assinatura de tokens JWT e verificação 2FA (mínimo 32 caracteres)
# Gere uma chave segura no terminal com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=substitua_esta_chave_por_uma_string_aleatoria_com_mais_de_32_caracteres_hex

# Conexão do banco de dados SQLite local em modo WAL
DATABASE_URL=file:./sqlite.db

# Lista de origens autorizadas pela política de CORS (separadas por vírgula, sem barras no final)
# Para produção corporativa, inclua o domínio institucional ou o IP fixo do servidor na intranet.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Flag de cookies seguros (defina como 'true' se a aplicação estiver operando sob HTTPS / SSL)
# Se estiver operando em rede local HTTP simples na escola, mantenha 'false'.
COOKIE_SECURE=false

# Ambiente de execução ('production' ou 'development')
NODE_ENV=production

# Configuração de provisionamento inicial (utilizado pelos scripts de seed/inicializador)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# Lista de contas administrativas protegidas contra exclusão acidental (separadas por vírgula)
PROTECTED_USERS=DesenvolvedorAdmin,admin